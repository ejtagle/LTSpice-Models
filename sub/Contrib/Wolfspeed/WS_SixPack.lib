C6 SQ2 Baseplate {CL1G}
C7 SQ4 Baseplate {CL2G}
C8 SQ6 Baseplate {CL3G}
.ENDS 4
 
*** SUBCKT 5/6: THERMALS ***
.SUBCKT 5 Tj Tc Vd Vs Vi
Vt Tj1 0 {Tj}
Rt Tj1 Tj 1m
RTground Tc 0 10k
.ENDS 5

.SUBCKT 6 Tj Tc Vd Vs Vi
Gpwr 0 Tj Value {abs(V(Vd,Vs)*(V(Vi)))}
Ct1 Tj 0 {Ct1}
Ct2 1 0 {Ct2}
Ct3 2 0 {Ct3}
Ct4 3 0 {Ct4}
Rt1 Tj 1 {Rt1}
Rt2 1 2 {Rt2}
Rt3 2 3 {Rt3}
Rt4 3 Tc {Rt4}
RTground Tc 0 10k
.ic V(Tj) = {Tj} V(1) = {Tj} V(2) = {Tj} V(3) = {Tj}
.ENDS 6
 
